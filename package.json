{
  "name": "leichter",
  "version": "1.0.0",
  "private": true,
  "description": "Leichter – Kalorientracker & Abnehm-App als PWA mit Benutzerkonten",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "dev": "node --watch --disable-warning=ExperimentalWarning server/index.js",
    "test": "node --disable-warning=ExperimentalWarning --test",
    "admin": "node --disable-warning=ExperimentalWarning server/admin.js",
    "icons": "NODE_PATH=$(npm root -g) node scripts/make-icons.mjs"
  },
  "optionalDependencies": {
    "better-sqlite3": "12.9.0"
  }
}
